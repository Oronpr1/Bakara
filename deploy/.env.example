# Copy to .env and fill in. Never commit .env.

# The public address of the system, e.g. https://letters.onomeeting.co.il
APP_URL=https://letters.example.com
# Same host without https:// (used by Caddy for the certificate, profile "https" only)
DOMAIN=letters.example.com

# Generate each with: openssl rand -base64 48
AUTH_SECRET=
POSTGRES_PASSWORD=

# Login codes and notifications are sent by email. Production needs SMTP (or Microsoft 365, below).
# Format: smtps://user:password@smtp.example.com:465  (or smtp://...:587)
SMTP_URL=
MAIL_FROM="מערכת מכתבי קבלה <letters@example.com>"

# Local port the web app listens on (127.0.0.1 only). Point your existing reverse proxy here.
WEB_PORT=3100

# Optional, later: Microsoft 365 (SharePoint working files, Graph mail) and the Word add-in.
# See apps/web/.env.example for the full list.
