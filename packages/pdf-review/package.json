{
  "name": "@al/pdf-review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "bin": {
    "al-pdf-review-copy-worker": "./scripts/copy-worker.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "demo": "vite --config demo/vite.config.ts",
    "demo:sample": "node scripts/make-sample-pdf.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pdf-lib": "^1.17.1",
    "playwright-core": "1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
