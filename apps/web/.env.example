DATABASE_URL=postgres://al:al@localhost:5432/acceptance_letters
# Long random string; used to hash session tokens. Required in production.
AUTH_SECRET=change-me-to-a-long-random-string
# Where outgoing notification mail goes in development (Mailpit). Login does not need mail.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="מערכת מכתבי קבלה <letters@example.test>"
APP_URL=http://localhost:3000
# Word add-in API (/api/addin/*). Bearer tokens from Entra ID; see apps/addin/README.md.
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_API_URI=api://letters-addin.college.ac.il/00000000-0000-0000-0000-000000000000
# The only browser origin allowed to call /api/addin/* (where the add-in is hosted).
# ADDIN_ORIGIN=https://letters-addin.college.ac.il

# Microsoft 365 (all optional; unset = the app works without it, as in local development).
# How the app signs in to Graph: a managed identity in Azure, else a certificate, else a
# client secret (development only; refused in production).
# M365_USE_MANAGED_IDENTITY=true
# M365_TENANT_ID=00000000-0000-0000-0000-000000000000
# M365_CLIENT_ID=00000000-0000-0000-0000-000000000000
# M365_CERT_PATH=/run/secrets/m365-app.pem
# M365_CLIENT_SECRET=dev-only
# The letters SharePoint site (Graph site id "host,siteCollectionId,webId"); the app has
# Sites.Selected on this site only. Set = "Edit in Word" and "Create version from SharePoint".
# M365_SITE_ID=college.sharepoint.com,00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000
# Lock the Word file after final approval by checking it out to the app (checked in on reopen).
# Off until tried on the college's tenant; without it, approved letters only hide "Edit in Word".
# M365_LOCK_APPROVED=checkout
# Shared mailbox that sends notifications through Graph (Mail.Send limited to this mailbox).
# When set it is used instead of SMTP_URL. Production needs this or SMTP_URL.
# M365_MAILBOX=letters@college.ac.il
