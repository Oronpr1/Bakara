DATABASE_URL=postgres://al:al@localhost:5432/acceptance_letters
# Long random string; used to hash login codes and session tokens. Required in production.
AUTH_SECRET=change-me-to-a-long-random-string
# Where outgoing mail goes in development (Mailpit). Unset = codes are printed to the server log.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="מערכת מכתבי קבלה <letters@example.test>"
APP_URL=http://localhost:3000
