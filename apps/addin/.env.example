# Copy to .env.production.local (or set in the build pipeline) before `pnpm --filter @al/addin build`.

# Where the built add-in is hosted (https, no trailing slash). Goes into manifest.xml.
VITE_ADDIN_BASE_URL=https://letters-addin.college.ac.il
# The acceptance-letters web app (API) origin.
VITE_API_BASE_URL=https://letters.college.ac.il
# Entra ID: the college tenant and the add-in's app registration.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Optional. Application ID URI of the API; default api://<add-in host>/<client id>.
# VITE_ENTRA_API_URI=
# Optional. Scope requested; default <API URI>/access_as_user.
# VITE_API_SCOPE=
# Optional. Support page shown in the Office store dialog; default <base>/support.html.
# VITE_ADDIN_SUPPORT_URL=
# Optional. Bump for every redeploy that changes the manifest (four parts).
# VITE_ADDIN_VERSION=1.0.0.0
# Optional. Fail the build if anything above is missing.
# VITE_ADDIN_STRICT=true
